{
  "name": "sagent",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"bun server.ts\" \"cd client && npm run dev\"",
    "sandbox": "concurrently \"AGENT_SANDBOXED_WORKERS=true bun server.ts\" \"cd client && npm run dev\"",
    "chrome:mcp": "node scripts/chrome-mcp-sse-server.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:client": "cd client && npm run build",
    "build": "npm run typecheck && npm run build:client",
    "lint": "eslint .",
    "stop": "node scripts/stop.js",
    "smoke": "node scripts/smoke-test.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@google/genai": "^2.7.0",
    "chrome-devtools-mcp": "^1.0.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.1",
    "express": "^4.18.2",
    "openai": "^4.47.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.2.1",
    "globals": "^17.5.0",
    "supertest": "^7.2.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
