# ─── API Keys ──────────────────────────────────────────────
NVIDIA_API_KEY=nvapi-...
# OpenAI 兼容接口地址，留空则默认 NVIDIA（https://integrate.api.nvidia.com/v1）
# NVIDIA_BASE_URL=https://

# Anthropic（Claude）。留空则不启用 Claude 供应商。
# ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini（https://ai.google.dev，原生 @google/genai SDK）。
# 留空则不启用 Gemini 供应商；配置后 Gemini 模型自动出现在模型列表，可与其它家混选竞速。
# 从 https://aistudio.google.com/apikey 获取。
# GEMINI_API_KEY=

# ─── Server ───────────────────────────────────────────────
PORT=3001
# HOST=0.0.0.0

# ─── Models ───────────────────────────────────────────────
# 模型列表在启动时从供应商接口（/v1/models）自动拉取，无需手动配置。
# MODELS 已废弃（保留仅为兼容），不再生效。


# ─── Agent ────────────────────────────────────────────────
AGENT_MAX_STEPS=64            # 单次任务最大步数，默认 8
AGENT_MODEL_TIMEOUT=120         # 单模型超时秒数
AGENT_MAX_HISTORY_STEPS=20     # 发送给 LLM 的最大历史步数（防止上下文溢出）
AGENT_MAX_RESULT_CHARS=1000    # 每步结果保留的最大字符数
AGENT_MEMORY_MAX_ENTRIES=20    # 记忆压缩阈值
AGENT_RESUME=false              # 后端重启后自动恢复未完成的 Agent 任务
AGENT_STAGGER_DELAY=1          # 多模型竞速批次间隔秒数
AGENT_BATCH_SIZE=2          # 每批启动模型数
AGENT_OBSERVE_DESKTOP=false    # 是否观测 macOS 桌面状态
# 兼容旧配置，WebView 后端会忽略该值
AGENT_HEADLESS=false

# ─── JetBrains IDE MCP（可选） ───────────────────────────
# 启用后，Agent 会额外暴露 ide_list_tools / ide_call_tool，
# 可通过 JetBrains 内置 MCP Server 与 IntelliJ IDEA / PyCharm / WebStorm 等 IDE 交互
# 建议先在 IDE 里 Settings | Tools | MCP Server 启用后，再把“Copy SSE Config”里的地址同步到这里
IDE_MCP_ENABLED=false
IDE_MCP_TRANSPORT=sse
IDE_MCP_HOST=127.0.0.1
IDE_MCP_PORT=64342
IDE_MCP_SSE_PATH=/sse
# IDE_MCP_URL=http://127.0.0.1:6365/sse
# IDE_MCP_MESSAGES_URL=http://127.0.0.1:6365/messages
IDE_PROJECT_PATH=.
# 如果你更偏好 stdio，也可以改成 transport=stdio，并按 IDE 的 Copy Stdio Config 填 command/args
# IDE_MCP_TRANSPORT=stdio
# IDE_MCP_COMMAND=npx
# IDE_MCP_ARGS=["-y","@jetbrains/mcp-proxy"]

# ─── Memory & Storage ────────────────────────────────────
# MEMORY_DIR=data

# ─── Chrome MCP（可选） ───────────────────────────────────
# 启用后，Agent 可通过 Chrome DevTools MCP 控制浏览器进行网页操作
CHROME_MCP_ENABLED=true
# 推荐 sandbox 模式使用 SSE：先在另一个非 sandbox 终端运行 `npm run chrome:mcp`
# bridge 默认使用 --isolated --no-usage-statistics --no-performance-crux 启动 chrome-devtools-mcp
CHROME_MCP_TRANSPORT=sse
CHROME_MCP_HOST=127.0.0.1
CHROME_MCP_PORT=3099
CHROME_MCP_SSE_PATH=/sse

# 每个 agent run 结束默认关闭本进程内的 Chrome MCP SSE client；外部 bridge/Chrome 不会被关闭。
# 如果你更看重复用连接速度，设为 true 即可保留 SSE client。
# CHROME_MCP_KEEP_OPEN=true

# agent run 结束（无论正常/异常）默认关闭本次 run 期间打开的 Chrome tab，避免堆积；
# chrome-devtools-mcp 会自动留一个空白 tab 兜底。如果想保留页面以便手动查看，设为 true。
# CHROME_MCP_KEEP_TABS=true

# navigate_page 在模型未传 timeout 时使用的默认超时（ms）。
# 默认 25000ms，覆盖国内重型门户站首屏加载；超时后还会做 busy 检测兜底。
# CHROME_MCP_NAVIGATE_TIMEOUT_MS=25000

# ─── Logging ──────────────────────────────────────────────
# debug | info (default) | warn | error
LOG_LEVEL=info
